{
  "name": "3x-ui-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "3x-ui panel frontend (React 19 + Ant Design 6 + Vite 8).",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run gen:api && vite build",
    "preview": "vite preview",
    "lint": "oxlint src tools",
    "lint:fix": "oxlint --fix src tools",
    "lint:deprecated": "oxlint --type-aware -A all -D typescript/no-deprecated src",
    "format": "oxfmt src tools",
    "format:check": "oxfmt --check src tools",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "gen": "npm run gen:zod && npm run gen:api",
    "gen:api": "node scripts/build-openapi.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "gen:zod": "cd .. && go run ./tools/openapigen",
    "prepare": "cd .. && husky frontend/.husky || true"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix"
    ]
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@hookform/resolvers": "^7.0.5",
    "@noble/hashes": "^2.4.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-devtools": "^5.107.1",
    "antd": "^6.7.0",
    "codemirror": "^6.0.2",
    "dayjs": "^1.11.23",
    "i18next": "^27.1.1",
    "otpauth": "^9.6.0",
    "persian-calendar-suite": "^1.5.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.1",
    "react-router": "^8.5.1",
    "swagger-ui-react": "^5.34.1",
    "uplot": "^1.6.32",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.5",
    "oxfmt": "0.78.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "^7.0.2006",
    "playwright": "^1.65.0",
    "storybook": "^10.6.7",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "react-copy-to-clipboard": "^5.1.1",
    "react-inspector": "^9.0.0",
    "seroval": "^1.6.8",
    "seroval-plugins": "^1.6.8",
    "react-debounce-input": {
      "react": "^19.0.0"
    },
    "swagger-ui-react": {
      "js-yaml": "^4.3.2",
      "brace-expansion": "^5.0.9",
      "minimatch": "^11.0.3"
    },
    "@joshwooding/vite-plugin-react-docgen-typescript": {
      "glob": "^14.0.3"
    },
    "@typeschema/valibot": {
      "valibot": "^1.1.0"
    },
    "@storybook/addon-vitest": {
      "vitest": "5.1.0",
      "@vitest/browser-playwright": "5.1.0",
      "@vitest/browser": "5.1.0"
    },
    "remarkable": {
      "argparse": "^2.0.1"
    }
  },
  "allowScripts": {
    "@scarf/scarf": false,
    "@tree-sitter-grammars/tree-sitter-yaml": false,
    "tree-sitter": false,
    "core-js-pure": false,
    "tree-sitter-json": false,
    "msw": false,
    "esbuild": false
  }
}
