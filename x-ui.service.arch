[Unit]
Description=x-ui Service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=180
StartLimitBurst=10

[Service]
EnvironmentFile=-/etc/conf.d/x-ui
Environment="XRAY_VMESS_AEAD_FORCED=false"
Type=simple
WorkingDirectory=/usr/local/x-ui/
ExecStart=/usr/local/x-ui/x-ui
ExecReload=/bin/kill -USR1 $MAINPID
Restart=on-failure
RestartSec=5s

# Low-resource defaults: keep the Go runtime to one worker thread and
# encourage earlier GC without imposing a hard memory OOM limit.
Environment="GOMAXPROCS=1"
Environment="GOMEMLIMIT=256MiB"
Environment="GOGC=80"
Environment="XUI_LOW_RESOURCE=true"
CPUQuota=100%
MemoryHigh=384M

# Arch Linux/systemd tuning for a proxy panel with many concurrent connections.
LimitNOFILE=1048576
TasksMax=infinity
OOMScoreAdjust=-100
UMask=0027
PrivateTmp=true

[Install]
WantedBy=multi-user.target
